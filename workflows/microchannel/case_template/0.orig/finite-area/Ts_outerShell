FoamFile
{
    version     2.0;
    format      ascii;
    class       areaScalarField;
    object      Ts_ceilingShell;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform @T_INIT@;

boundaryField
{
    bottomEdge
    {
        type            zeroGradient;
    }

    inletEdge
    {
        type            zeroGradient;
    }

    outletEdge
    {
        type            zeroGradient;
    }
}



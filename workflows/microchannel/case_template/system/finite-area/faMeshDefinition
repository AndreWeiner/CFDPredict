FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      faMeshDefinition;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
polyMeshPatches ( thermalShell );

boundary
{
    bottomEdge
    {
        type patch;
        neighbourPolyPatch  centerPlane;
    }

    inletEdge
    {
        type patch;
        neighbourPolyPatch  inlet;
    }

    outletEdge
    {
        type patch;
        neighbourPolyPatch  outlet;
    }

}


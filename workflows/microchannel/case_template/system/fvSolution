FoamFile {
    version 2.0;
    format ascii;
    class dictionary;
    object fvSolution;
}

// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers {
    "rho.*"

    {
        solver PCG;
        preconditioner DIC;
        tolerance 1e-7;
        relTol 0;
    }

    p_rgh
    {
        solver GAMG;
        smoother FDIC;
        tolerance 1e-06;
        relTol 0.01;
    }

    p_rghFinal 
    {
        $p_rgh;
        tolerance 1e-6;
        relTol 0;
    }

    "(U|h|T|k|epsilon|omega|e)"

        {
        solver PBiCGStab;
        preconditioner DILU;
        tolerance 1e-07;
        relTol 0.01;
    }

    "(U|h|T|k|epsilon|omega|e)Final"

        {
        solver PBiCGStab;
        preconditioner DILU;
        tolerance 1e-07;
        relTol 0;
    }
}

PIMPLE {
    momentumPredictor yes;
    consistent yes;
    nCorrectors @N_CORRECTORS@;
    nNonOrthogonalCorrectors 1;
    nOuterCorrectors 1;
    pMinFactor   0.5;
    pMaxFactor     2;
}

relaxationFactors {
    equations {
        ".*" 1;
    }
    fields
    {
        rho             1;
        p_rgh           1;
    }
}


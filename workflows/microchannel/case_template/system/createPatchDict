FoamFile
{
version     2.0;
format ascii;
class dictionary;
object createPatchDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Renames/splits extrudeMesh's generic "originalPatch"/"otherSide"/"sides"
// patches into this case's actual boundary names. Run after topoSet has
// built the centerPlaneFaces faceSet.
//
// thermalShell must be listed before centerPlane: createPatch resolves
// overlapping claims on a face by last-entry-wins, and thermalShell's
// "constructFrom patches (sides)" claims *all* of sides (including the
// centerPlane subset) since it looks up original patch membership, not
// what's already been claimed by earlier entries -- so centerPlane has to
// come second to actually carve its faces back out.
pointSync false;
patches
(
    {
        name thermalShell;
        patchInfo { type wall; }
        constructFrom patches;
        patches (sides);
    }
    {
        name centerPlane;
        patchInfo { type symmetryPlane; }
        constructFrom set;
        set centerPlaneFaces;
    }
    {
        name inlet;
        patchInfo { type patch; }
        constructFrom patches;
        patches (originalPatch);
    }
    {
        name outlet;
        patchInfo { type patch; }
        constructFrom patches;
        patches (otherSide);
    }
);


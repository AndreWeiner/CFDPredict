#!/bin/sh
cd "${0%/*}" || exit                                # Run from this directory
. ${WM_PROJECT_DIR:?}/bin/tools/RunFunctions        # Tutorial run functions
#------------------------------------------------------------------------------

# --- mesh: extrude the 2D cross-section in Z, then split/rename the
# boundary patches. Serial: extrudeMesh has no -parallel mode; the finished
# mesh is decomposed below. build_case.py writes constant/triSurface/mesh.obj and
# the extrudeMeshDict.stageN files; see Allrun for why these always re-run.
runApplication -o -s stage1 extrudeMesh -dict system/extrudeMeshDict.stage1
runApplication -o -s stage2 extrudeMesh -dict system/extrudeMeshDict.stage2
runApplication -o -s stage3 extrudeMesh -dict system/extrudeMeshDict.stage3

runApplication -o topoSet
runApplication -o createPatch -overwrite

runApplication restore0Dir

runApplication decomposePar

runParallel makeFaMesh

runParallel $(getApplication)

#------------------------------------------------------------------------------

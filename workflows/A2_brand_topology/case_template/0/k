dimensions      [0 2 -2 0 0 0 0];

internalField   uniform @K_INIT@;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform @K_INIT@;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform @K_INIT@;
        value           uniform @K_INIT@;
    }
    walls
    {
        type            kqRWallFunction;
        value           uniform @K_INIT@;
    }
    "vane.*"
    {
        type            kqRWallFunction;
        value           uniform @K_INIT@;
    }
    frontAndBack
    {
        type            empty;
    }
}


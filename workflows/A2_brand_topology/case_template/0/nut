/*--------------------------------*- C++ -*----------------------------------*\
  CFDPredict A2 - 0/nut (template)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 0;
    }
    outlet
    {
        type            calculated;
        value           uniform 0;
    }
    walls
    {
        // nutUSpalding: tau_w-basiert, meldet ECHTES y+ (kontinuierlich y+ 1-300),
        // im Gegensatz zu nutkWallFunction (meldet y* = C_mu^0.25*sqrt(k)).
        // Re-adaptive Wandaufloesung (build_case auto_layers) haelt y+ konstant;
        // nutUSpalding degradiert sauber von wandaufgeloest (y+~1) bis Wandfunktion.
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
    "vane.*"
    {
        type            nutUSpaldingWallFunction;
        value           uniform 0;
    }
    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //

/*--------------------------------*- C++ -*----------------------------------*\
  CFDPredict A2 - fvSolution (template)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      fvSolution;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solvers
{
    p
    {
        solver          GAMG;
        tolerance       1e-7;
        relTol          0.05;
        smoother        GaussSeidel;
    }

    // potentialFoam-Loeser fuer die Startfeld-Initialisierung. PCG/DIC statt
    // GAMG: robust auf den hohen Aspect-Ratio-Zellen wandaufgeloester Gitter
    // (y+~1), wo GAMG-Agglomeration im scale() einen FPE wirft.
    Phi
    {
        solver          PCG;
        preconditioner  DIC;
        tolerance       1e-8;
        relTol          0.01;
    }

    U
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
    }

    "(k|omega)"
    {
        solver          smoothSolver;
        smoother        symGaussSeidel;
        tolerance       1e-8;
        relTol          0.1;
    }
}

potentialFlow
{
    // Startfeld-Init via potentialFoam: erzeugt ein quellfreies U-Feld, damit
    // simpleFoam nicht aus dem uniformen IC heraus aufblaest (kritisch auf den
    // feinen y+~1-Gittern bei hohem Re; auf groben Gittern unschaedlich).
    nNonOrthogonalCorrectors 10;
}

SIMPLE
{
    nNonOrthogonalCorrectors 0;
    consistent               yes;

    residualControl
    {
        p           1e-4;
        U           1e-5;
        "(k|omega)" 1e-5;
    }
}

relaxationFactors
{
    fields
    {
        p           0.3;
    }
    equations
    {
        U           0.7;
        "(k|omega)" 0.7;
    }
}


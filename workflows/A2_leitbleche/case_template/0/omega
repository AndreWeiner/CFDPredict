/*--------------------------------*- C++ -*----------------------------------*\
  CFDPredict A2 - 0/omega (template)
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0";
    object      omega;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 -1 0 0 0 0];

internalField   uniform @OMEGA_INIT@;

boundaryField
{
    inlet
    {
        type            fixedValue;
        value           uniform @OMEGA_INIT@;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform @OMEGA_INIT@;
        value           uniform @OMEGA_INIT@;
    }
    walls
    {
        type            omegaWallFunction;
        value           uniform @OMEGA_INIT@;
    }
    "vane.*"
    {
        type            omegaWallFunction;
        value           uniform @OMEGA_INIT@;
    }
    frontAndBack
    {
        type            empty;
    }
}


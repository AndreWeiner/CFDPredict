FoamFile
{
    version         2.0;
    format          ascii;
    class           volScalarField;
    location        "0";
    object          nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// Wall-Function-Wahl (Lesson 040): nutkWallFunction vs nutUSpaldingWallFunction
// liefern bei unserem y+ ~62 (mid log-layer) praktisch identische p_inlet (<0.2%
// Differenz) und Film +/-5%. Spalding waere theoretisch universeller (gilt auch
// fuer y+<11), nutk reicht hier aus.
dimensions      [0 2 -1 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    inlet         { type calculated; value uniform 0; }
    outlet        { type calculated; value uniform 0; }
    lexit_side    { type calculated; value uniform 0; }
    wall          { type nutkWallFunction; value uniform 0; }
    chamberBottom { type nutkWallFunction; value uniform 0; }
}

